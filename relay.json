{
  "id": "autoclaw",
  "name": "AutoClaw 反代",
  "port": 18766,
  "host": "127.0.0.1",
  "start": {
    "cmd": [
      "~/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
      "~/.autoclaw-relay/autostart.py"
    ],
    "cwd": "~/.autoclaw-relay",
    "wait_seconds": 15
  },
  "stop": {
    "cmdline_match": "server\\.mjs"
  },
  "health": {
    "type": "tcp"
  }
}
